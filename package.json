{
  "name": "tripora",
  "private": true,
  "version": "0.1.0",
  "description": "Tripora — planification de voyages entre amis, gratuite et collaborative",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @tripora/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "serialize-javascript@<7.1.3": "^7.1.4",
      "source-map-js@<1.2.2": "^1.2.2",
      "uuid@<11.1.1": "^11.1.1",
      "tinypool@<2.1.2": "^2.2.0",
      "zod@<4.6.6": "^4.6.7"
    }
  }
}
