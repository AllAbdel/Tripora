    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "flag-icons": "^7.5.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
