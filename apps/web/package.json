{
  "name": "@tripora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/generer-pages-publiques.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "flags": "tsx scripts/generate-flags.mjs",
    "lint": "eslint src scripts e2e --max-warnings 0",
    "smoke": "node scripts/smoke.mjs",
    "build:mobile": "tsc --noEmit && vite build --mode mobile"
  },
  "dependencies": {
    "@capacitor/app": "catalog:",
