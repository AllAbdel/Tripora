# Configuration de l'application mobile, publique comme apps/web/.env.
#
# Dans l'application, la page est servie depuis le téléphone lui-même
# (https://localhost sur Android, capacitor://localhost sur iOS). Un lien
# d'invitation construit sur cette adresse n'ouvrirait rien chez les autres :
# les liens partagés partent donc de l'adresse publique du site.
VITE_SITE_ORIGIN=https://tripora-eight.vercel.app

# Où Supabase renvoie après la connexion Google : une page du site principal
# du projet (son « Site URL »), toujours acceptée, qui rouvre l'application.
# Voir src/lib/retourApp.ts. Doit rester sur le domaine du Site URL de
# Supabase, sinon Supabase la refuse et retombe sur le site.
VITE_RETOUR_APP=https://tripora-3rg.pages.dev/retour-app/
