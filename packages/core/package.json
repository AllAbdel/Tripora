{
  "name": "@tripora/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Logique métier pure de Tripora : types, schémas, calcul de coût, scoring. Aucune dépendance réseau.",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./activites": "./src/catalog/activites.ts",
    "./visas": "./src/visas.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "build": "tsc --noEmit",
    "seed:sql": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.13",
    "vitest": "^4.1.12"
  }
}
